<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageVersionOverrideEnabled>false</CentralPackageVersionOverrideEnabled>
    <!-- Keep non-net11 consumers on .NET 10 dependencies; OpenTelemetry 1.21 requires DiagnosticSource 11 on net10. -->
    <MicrosoftRuntimePackageVersion>10.0.15</MicrosoftRuntimePackageVersion>
    <OpenTelemetryPackageVersion>1.20.1</OpenTelemetryPackageVersion>
    <OpenTelemetryWebInstrumentationPackageVersion>1.20.2</OpenTelemetryWebInstrumentationPackageVersion>
  </PropertyGroup>
  <PropertyGroup Condition="'$(TargetFramework)' == 'net11.0'">
    <MicrosoftRuntimePackageVersion>11.0.0</MicrosoftRuntimePackageVersion>
    <OpenTelemetryPackageVersion>1.21.0</OpenTelemetryPackageVersion>
    <OpenTelemetryWebInstrumentationPackageVersion>1.21.0</OpenTelemetryWebInstrumentationPackageVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageVersion Include="Handlebars.Net" Version="2.5.0" />
    <PackageVersion Include="System.IO.FileSystem.Primitives" Version="4.3.0" />
    <PackageVersion Include="System.Reactive" Version="7.0.0" />
    <PackageVersion Include="Humanizer" Version="3.0.10" />
    <PackageVersion Include="Microsoft.SourceLink.GitHub" Version="11.0.100" />
    <PackageVersion Include="OneOf" Version="3.0.271" />
    <PackageVersion Include="OneOf.SourceGenerator" Version="3.0.271" />
    <!-- Roslyn-->
    <!-- Keep Roslyn compatible with the .NET 10 SDK so packaged generators can load in its compiler host. -->
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp" Version="5.9.0" />
    <PackageVersion Include="Microsoft.CodeAnalysis.CSharp.Workspaces" Version="5.9.0" />
    <!-- Analysis -->
    <PackageVersion Include="StyleCop.Analyzers" Version="1.3.180" />
    <PackageVersion Include="Roslynator.Analyzers" Version="5.0.1" />
    <PackageVersion Include="Meziantou.Analyzer" Version="3.0.342" />
    <!-- Specifications -->
    <PackageVersion Include="Cratis.Specifications.Runner" Version="5.3.0" />
    <PackageVersion Include="Cratis.Specifications.XUnit.v3" Version="5.3.0" />
    <PackageVersion Include="xunit.v3.mtp-off" Version="4.0.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="4.0.1" />
    <PackageVersion Include="Moq" Version="4.21.0" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.12.0" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="$(MicrosoftRuntimePackageVersion)" />
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="$(MicrosoftRuntimePackageVersion)" />
    <PackageVersion Include="Microsoft.Extensions.DependencyModel" Version="$(MicrosoftRuntimePackageVersion)" />
    <PackageVersion Include="System.Text.Json" Version="$(MicrosoftRuntimePackageVersion)" />
    <PackageVersion Include="OpenTelemetry" Version="$(OpenTelemetryPackageVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="$(MicrosoftRuntimePackageVersion)" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="$(MicrosoftRuntimePackageVersion)" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="$(OpenTelemetryPackageVersion)" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="$(OpenTelemetryPackageVersion)" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="$(OpenTelemetryWebInstrumentationPackageVersion)" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="$(OpenTelemetryWebInstrumentationPackageVersion)" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="$(OpenTelemetryPackageVersion)" />
    <PackageVersion Include="System.Diagnostics.DiagnosticSource" Version="$(MicrosoftRuntimePackageVersion)" />
  </ItemGroup>
</Project>