<?xml version="1.0" encoding="UTF-8" ?>
<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <IsTestProject>true</IsTestProject>
        <!-- xUnit v3 test projects are executables -->
        <OutputType>Exe</OutputType>
        <IsPackable>false</IsPackable>
        <AssemblyName>Cratis.Fundamentals.TypeDiscovery.Generator.Specs</AssemblyName>
        <RootNamespace>Cratis.Fundamentals.TypeDiscovery.Generator.Specs</RootNamespace>
        <TargetFrameworks>net10.0</TargetFrameworks>
        <LangVersion>13</LangVersion>
        <!-- Leases for the #1210 infrastructure probe. Only compiled in when FUNDAMENTALS_SPECS_PROBE is set at build time, so default builds keep the unobserved fast path. -->
        <CratisSpecificationsSharedResources Condition="'$(FUNDAMENTALS_SPECS_PROBE)' != ''">true</CratisSpecificationsSharedResources>
        <!-- Trials the experimental Cratis.Specifications shared resources (Cratis/Fundamentals#1210). -->
        <NoWarn>$(NoWarn);SA1600;CRSPECEXP01</NoWarn>
    </PropertyGroup>

    <!-- The shared GlobalUsings.Specs.cs references Cratis.Types which is not needed here. -->
    <!-- Provide our own global usings instead. -->
    <ItemGroup>
        <Compile Remove="$(MSBuildThisFileDirectory)/../GlobalUsings.Specs.cs" />
    </ItemGroup>

    <ItemGroup>
        <EmbeddedResource Include="for_TypeDiscoverySourceGenerator/when_preserving_generated_output/*.txt" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="../Fundamentals.TypeDiscovery.Generator/Fundamentals.TypeDiscovery.Generator.csproj" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
    </ItemGroup>
</Project>
