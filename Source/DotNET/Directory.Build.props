<Project>
    <Import Project="$(MSBuildThisFileDirectory)../../Directory.Build.props" />
    
    <PropertyGroup>
        <Version>1.0.0</Version>
        <Copyright>Copyright Cratis</Copyright>
        <Authors>Cratis</Authors>
        <Company>Cratis</Company>
        <DebugType>portable</DebugType>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <RepositoryType>git</RepositoryType>
        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <RepositoryUrl>https://github.com/Cratis/Fundamentals</RepositoryUrl>
        <PackageProjectUrl>https://www.cratis.io/fundamentals/</PackageProjectUrl>
        <Description>The shared building blocks beneath the Cratis stack — concepts, serialization, dependency injection, and type discovery for .NET</Description>
        <PackageTags>utilities;concepts;type-discovery;serialization;dependency-injection;cratis</PackageTags>

        <GenerateAssemblyTitleAttribute>true</GenerateAssemblyTitleAttribute>
        <GenerateAssemblyDescriptionAttribute>true</GenerateAssemblyDescriptionAttribute>

        <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
        <GenerateDocumentationFile>true</GenerateDocumentationFile>
        <IsTestProject>false</IsTestProject>

        <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
        <IsPackable>true</IsPackable>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageIcon>logo.png</PackageIcon>
        <AllowedOutputExtensionsInPackageBuildOutputFolder>$(AllowedOutputExtensionsInPackageBuildOutputFolder);.pdb</AllowedOutputExtensionsInPackageBuildOutputFolder>
    </PropertyGroup>
    <PropertyGroup Condition="'$(Configuration)'=='Debug'">
        <TreatWarningsAsErrors>False</TreatWarningsAsErrors>
        <MSBuildTreatWarningsAsErrors>False</MSBuildTreatWarningsAsErrors>
        <CodeAnalysisTreatWarningsAsErrors>False</CodeAnalysisTreatWarningsAsErrors>
        <StyleCopTreatErrorsAsWarnings>True</StyleCopTreatErrorsAsWarnings>
    </PropertyGroup>

    <PropertyGroup Condition="'$(Configuration)'=='Release'">
        <TreatWarningsAsErrors>True</TreatWarningsAsErrors>
        <MSBuildTreatWarningsAsErrors>True</MSBuildTreatWarningsAsErrors>
        <CodeAnalysisTreatWarningsAsErrors>True</CodeAnalysisTreatWarningsAsErrors>
        <StyleCopTreatErrorsAsWarnings>False</StyleCopTreatErrorsAsWarnings>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="All" />
    </ItemGroup>

    <ItemGroup>
        <None Include="$(MSBuildThisFileDirectory)/../../README.md" Pack="true" PackagePath="/" />
        <None Include="$(MSBuildThisFileDirectory)/../../logo.png" Pack="true" PackagePath="/" />
        <Compile Include="$(MSBuildThisFileDirectory)/GlobalAssemblyInfo.cs" />
    </ItemGroup>

    <ItemGroup Condition="'$(IsTestProject)'=='true' and '$(UseCratisSpecificationsRunner)'!='true'">
        <PackageReference Include="Cratis.Specifications.XUnit.v3" />
        <PackageReference Include="Moq" />
        <PackageReference Include="xunit.v3.mtp-off" />
        <PackageReference Include="xunit.runner.visualstudio" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" />
        <Compile Include="$(MSBuildThisFileDirectory)/GlobalUsings.Specs.cs" />
    </ItemGroup>

    <ItemGroup Condition="'$(UseCratisSpecificationsRunner)'=='true'">
        <PackageReference Include="Cratis.Specifications.Runner" />
        <Compile Include="$(MSBuildThisFileDirectory)/GlobalUsings.Runner.Specs.cs" />
    </ItemGroup>

    <!--
        An xUnit v3 test project is also an executable, but still needs the VSTest adapter for IDEs.
        A test project without the VSTest adapter beside it is not a failing test project - it is an
        invisible one. `dotnet test` reports "No test is available", skips it, and exits 0, so its specs
        simply stop counting and nothing says so. Three projects in this repo were in that state.
        Assert the adapter landed rather than trusting that referencing the package was enough.
        Standalone runner projects use Microsoft.Testing.Platform generation instead; assert it is enabled.
    -->
    <Target Name="EnsureTestProjectIsDiscoverable"
            AfterTargets="Build"
            Condition="'$(IsTestProject)'=='true' and '$(UseCratisSpecificationsRunner)'!='true' and '$(TargetFramework)'!=''">
        <Error Condition="!Exists('$(OutputPath)xunit.runner.visualstudio.testadapter.dll')"
               Text="$(MSBuildProjectName) is a test project but its output has no VSTest adapter, so `dotnet test` will silently skip it. This happens when the project sets the singular &lt;TargetFramework&gt; while Directory.Build.props sets &lt;TargetFrameworks&gt; - use the plural form." />
    </Target>
    <Target Name="EnsureSpecificationRunnerIsApplied"
            AfterTargets="Build"
            Condition="'$(UseCratisSpecificationsRunner)'=='true' and '$(TargetFramework)'!=''">
        <Error Condition="'$(GenerateTestingPlatformEntryPoint)'!='true' or '$(GenerateSelfRegisteredExtensions)'!='true'"
               Text="$(MSBuildProjectName) uses the Cratis Specifications runner but its Microsoft.Testing.Platform entry point or extension generation is disabled." />
    </Target>
</Project>
