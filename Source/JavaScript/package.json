{
    "name": "@cratis/fundamentals",
    "version": "1.0.5-test2",
    "description": "The shared building blocks beneath the Cratis stack — GUIDs, concepts, derived-type serialization, property-path proxies, and decorators for TypeScript",
    "keywords": [
        "cratis",
        "fundamentals",
        "typescript",
        "serialization",
        "guid",
        "concepts",
        "reflection"
    ],
    "homepage": "https://www.cratis.io/fundamentals/",
    "author": "Cratis",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Cratis/Fundamentals.git"
    },
    "publishConfig": {
        "access": "public"
    },
    "files": [
        "dist",
        "**/*.ts"
    ],
    "main": "dist/cjs/index.js",
    "module": "dist/esm/index.js",
    "types": "dist/esm/index.d.ts",
    "exports": {
        "./package.json": "./package.json",
        ".": {
            "import": {
                "types": "./dist/esm/index.d.ts",
                "default": "./dist/esm/index.js"
            },
            "require": {
                "types": "./dist/cjs/index.d.ts",
                "default": "./dist/cjs/index.js"
            }
        },
        "./geospatial": {
            "import": {
                "types": "./dist/esm/geospatial/index.d.ts",
                "default": "./dist/esm/geospatial/index.js"
            },
            "require": {
                "types": "./dist/cjs/geospatial/index.d.ts",
                "default": "./dist/cjs/geospatial/index.js"
            }
        },
        "./json": {
            "import": {
                "types": "./dist/esm/json/index.d.ts",
                "default": "./dist/esm/json/index.js"
            },
            "require": {
                "types": "./dist/cjs/json/index.d.ts",
                "default": "./dist/cjs/json/index.js"
            }
        },
        "./reflection": {
            "import": {
                "types": "./dist/esm/reflection.d.ts",
                "default": "./dist/esm/reflection.js"
            },
            "require": {
                "types": "./dist/cjs/reflection.d.ts",
                "default": "./dist/cjs/reflection.js"
            }
        }
    },
    "installConfig": {
        "hoistingLimits": "workspaces"
    },
    "devDependencies": {
        "@typescript/native": "npm:typescript@^7.0.2",
        "rollup": "4.63.4",
        "rollup-plugin-typescript2": "0.37.0",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "typescript-programmatic-api": "npm:@typescript/typescript6@^6.0.2"
    },
    "scripts": {
        "prepare": "yarn build",
        "clean": "yarn g:clean",
        "build": "yarn g:build && node scripts/fix-declarations.mjs",
        "lint": "yarn g:lint",
        "lint:ci": "yarn g:lint:ci",
        "test": "yarn g:test",
        "test:watch": "yarn g:test:watch",
        "ci": "yarn clean && yarn lint:ci && yarn build && yarn test:consumers && yarn test",
        "test:consumers": "node scripts/check-consumers.mjs",
        "up": "yarn g:up"
    }
}
